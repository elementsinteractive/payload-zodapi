{
	"extends": "../tsconfig.json",
	"exclude": [],
	"include": [
		"**/*.js",
		"**/*.jsx",
		"**/*.mjs",
		"**/*.cjs",
		"**/*.ts",
		"**/*.tsx",
		"../src/**/*.ts",
		"../src/**/*.tsx",
		"next.config.mjs",
		".next/types/**/*.ts"
	],
	"compilerOptions": {
		"paths": {
			"@payload-config": ["./payload.config.ts"],
			"payload-zodapi": ["../src/index.ts"],
			"payload-zodapi/testing": ["../src/testHelpers.ts"]
		},
		"noEmit": true,
		"emitDeclarationOnly": false
	}
}
